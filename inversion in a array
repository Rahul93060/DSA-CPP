#include<iostream>
#include<vector>
using namespace std;

int ms(vector<int>&arr,int st,int end,int mid){
    vector<int>temp;
    int i=st;
    int j=mid+1;
    int con=0;
    while(i<=mid && j<=end){
        if(arr[i]<=arr[j]){
            temp.push_back(arr[i]);
            i++;
        }else{
            temp.push_back(arr[j]);
            con+= (mid-i+1);
            j++;
            
        }
    }
    while(i<=mid){
         temp.push_back(arr[i]);
            i++;
    }
    while(j<=end){
        temp.push_back(arr[j]);
            j++;
    }
    for(int idx=0;idx<temp.size();idx++){
        arr[idx+st]=temp[idx];
    }
    return con;
    
}
int merge(vector<int>&arr,int st,int end){
    
    if(st<end){
        int mid=st+(end-st)/2;
        
        int a=merge(arr,st,mid);
        int b=merge(arr,mid+1,end);
        
        int c=ms(arr,st,end,mid);
        return a+b+c;
    }
    
    return 0;
}



int main(){
    vector<int>arr={6,3,5,2,7};
    int n=arr.size()-1;
    int d = merge(arr,0,n);
  cout<<d;

}